<Window x:Class="QControl.Setup.Ui.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Q-Control 安装程序"
        Width="720" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SetupStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource BDim}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BPanel}"
            BorderBrush="{StaticResource BLine}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ======================================================== 顶栏 -->
            <Grid Grid.Row="0" Margin="28,24,18,0" Background="Transparent"
                  MouseLeftButtonDown="OnHeaderDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Width="46" Height="46" Source="/Assets/qcontrol.ico"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" />

                <StackPanel Grid.Column="1" Margin="14,0,44,0" VerticalAlignment="Center">
                    <TextBlock Text="Q-Control 控制中心"
                               FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource BText}" />
                    <TextBlock x:Name="SubTitle" Margin="0,5,0,0"
                               FontSize="12" Foreground="{StaticResource BDim}" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="CloseBtn" Content="✕"
                        Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnCloseClick" />
            </Grid>

            <!-- ======================================================== 主体 -->
            <Grid Grid.Row="1" Margin="0,0,0,0">

                <!-- ======================================== 配置页 -->
                <StackPanel x:Name="P_Config" Margin="28,22,28,0">
                    <TextBlock x:Name="IntroText" TextWrapping="Wrap"
                               Foreground="{StaticResource BDim}" LineHeight="21" />

                    <TextBlock x:Name="DirLabel" Text="安装位置" Margin="0,20,0,7"
                               FontSize="12" Foreground="{StaticResource BDim}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DirBox" Style="{StaticResource DarkTextBox}" Height="34"
                                 TextChanged="OnDirChanged" />
                        <Button Grid.Column="1" x:Name="BrowseBtn" Content="浏览…"
                                Width="78" Height="34" Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}" Click="OnBrowseClick" />
                    </Grid>

                    <TextBlock x:Name="SpaceText" Margin="0,7,0,0"
                               FontSize="11.5" Foreground="#6f7c90" />

                    <CheckBox x:Name="DesktopChk" Content="创建桌面快捷方式" Margin="0,18,0,0"
                              IsChecked="True" Style="{StaticResource DarkCheck}" />

                    <CheckBox x:Name="PurgeChk" Content="同时删除配置与日志（含风扇曲线、灯效等设置）"
                              Margin="0,14,0,0" IsChecked="False" Visibility="Collapsed"
                              Style="{StaticResource DarkCheck}" />

                    <Border Background="{StaticResource BCard}" BorderBrush="{StaticResource BLine}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,18,0,0">
                        <TextBlock x:Name="NoteText" TextWrapping="Wrap"
                                   FontSize="12" LineHeight="20"
                                   Foreground="{StaticResource BDim}" />
                    </Border>
                </StackPanel>

                <!-- ======================================== 进度页 -->
                <StackPanel x:Name="P_Progress" Margin="28,0,28,0" Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ProgTitle" Text="正在安装"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource BText}" />
                    <ProgressBar x:Name="ProgBar" Style="{StaticResource DarkProgress}"
                                 Minimum="0" Maximum="100" Value="0" Margin="0,16,0,0" />
                    <TextBlock x:Name="ProgText" Margin="0,12,0,0"
                               FontSize="12.5" Foreground="{StaticResource BDim}" />
                    <TextBlock x:Name="ProgError" Margin="0,16,0,0" TextWrapping="Wrap"
                               FontSize="12.5" LineHeight="21"
                               Foreground="{StaticResource BBad}" Visibility="Collapsed" />
                </StackPanel>

                <!-- ======================================== 完成页 -->
                <StackPanel x:Name="P_Done" Margin="28,0,28,0" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="27"
                            BorderBrush="{StaticResource BOk}" BorderThickness="1.5"
                            Background="#14261f" HorizontalAlignment="Center">
                        <TextBlock Text="✓" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource BOk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="DoneTitle" Text="安装完成" Margin="0,16,0,0"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource BText}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DoneText" Margin="0,8,0,0" MaxWidth="520"
                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="21"
                               FontSize="12.5" Foreground="{StaticResource BDim}" />
                    <CheckBox x:Name="LaunchChk" Content="立即启动 Q-Control" Margin="0,20,0,0"
                              IsChecked="True" HorizontalAlignment="Center"
                              Style="{StaticResource DarkCheck}" />
                </StackPanel>
            </Grid>

            <!-- ======================================================== 底栏 -->
            <Border Grid.Row="2" Margin="0,18,0,0" Padding="28,16"
                    BorderThickness="0,1,0,0" BorderBrush="{StaticResource BLine}">
                <Grid>
                    <TextBlock x:Name="FootHint" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="#6f7c90" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelBtn" Content="取消" Width="92" Height="36"
                                Style="{StaticResource GhostButton}" Click="OnCancelClick" />
                        <Button x:Name="PrimaryBtn" Content="安装" Width="116" Height="36"
                                Margin="10,0,0,0" Style="{StaticResource PrimaryButton}"
                                Click="OnPrimaryClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
