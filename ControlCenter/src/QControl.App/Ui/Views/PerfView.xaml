<UserControl x:Class="QControl.App.Ui.Views.PerfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:QControl.App.Ui"
             Background="Transparent">

  <!--
    性能页 —— **两列并排**：
      左：系统与显卡模式（三档情景卡 + 每档功耗墙 + 显卡模式三档 + 电源计划列表）
      右：显卡超频（6 行实时值 + 两条滑块 + 应用 / 复位 + 免责声明）

    ⚠️ 是**左右两列**不是上下两张全宽卡：模式卡与超频卡各占一列，等高并排。
       本项目窗口宽度 = 工作区 62%，落在 2 列那一档；上下堆叠会立刻超出一屏、多出滚动条。
    ⚠️ 两张卡等高（同一 Grid 行，默认 Stretch）。左卡内容少一截，靠**两条星号间隔行**
       把余量摊到"模式 / 显卡 / 电源计划"三块之间 —— 等价 space-between。
    ⚠️ 三档模式卡的按钮与功耗墙小字都由 code-behind 造（见 BuildModes）：
       功耗墙"每档最多两行、没有就整块隐藏"，写死在 XAML 里没法整块收起。
  -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QControl;component/Ui/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- ⚠️ Style=PageScroll：滚动条**浮**在最外侧 8px 上，出现时不挤动卡片（见 Theme.xaml 同名样式） -->
  <ScrollViewer x:Name="Scroll" Style="{StaticResource PageScroll}"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                VerticalContentAlignment="Stretch" Focusable="False" Padding="0">
    <!-- ⚠️ **卡片高度由内容决定、整组上下居中**。
         别让 Root 直接把卡片 Stretch：Root.MinHeight 被 FillViewport 钉成视口高后，两张卡会被
         **拉**到 708 高、卡内全是空档；这里 Root 照样撑满视口，但 CardGrid 是 Center
         不是 Stretch ⇒ 卡片**不被拉高**，只是整组落在视口正中（上下留白对半）。
         两张卡同处一行 ⇒ 仍然等高，高的是内容高的那一张。 -->
    <!-- ⚠️ Root 撑满视口（MinHeight 由 UiKit.FillViewport 钉，见 code-behind）：
         不撑满就没"上下居中"这回事 —— 内容矮时一屏高、卡片组在中间；
         内容高时 Root 被顶到内容高，居中自动退化成顶对齐，照常滚动。 -->
    <Grid x:Name="Root" VerticalAlignment="Stretch">
    <!-- ⚠️ **上下居中，不是左右居中**。
         横向照旧撑满页框（左右不居中，别再加 MaxWidth）；纵向 Center：
         本页内容比一屏矮，卡片组落在视口正中，上下留白对半。
         ⚠️ 卡片**不跟着变高**：居中≠拉伸，高度仍由内容决定，
            两张卡同处一行 ⇒ 等高，但高的是内容高的那一张。 -->
    <Grid x:Name="CardGrid" Margin="19,15,19,15" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ==================== 系统与显卡模式 ==================== -->
      <!-- 间隔由 UiKit.ApplyCardGap(CardGrid) 统一发放，卡上不写 Margin -->
      <Border Grid.Column="0" Style="{StaticResource CardBox}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource CardIcon}" Data="{x:Static ui:Icons.Mode}"/>
              <TextBlock Text="系统与显卡模式" Style="{StaticResource CardTitle}"/>
            </StackPanel>
            <Border Style="{StaticResource CardTag}">
              <TextBlock x:Name="PerfState" Text="读取中…" Style="{StaticResource CardTagText}"/>
            </Border>
          </Grid>

          <!-- 三行 + 两个星号间隔行 = justify-content:space-between 的等价物
               （内容比卡片高时星号行自然收成 0，不会把内容挤扁） -->
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ① 三档（办公 / 游戏 / 狂暴）：按钮 + 该档实测功耗墙 -->
            <StackPanel Grid.Row="0">
              <Grid x:Name="ModesHost">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
              </Grid>

              <!-- 拔电自动切办公模式（原厂同款行为，真源 presets.perf.auto_office_on_battery）
                   ⚠️ 开关由 code-behind 造（见 BuildAutoRow）：SwitchButton 的"点击不改状态"
                      语义要求 IsOn 只由真值渲染，写死在 XAML 里就会被 WPF 的按钮状态带跑。
                   ⚠️ 没有电池的机型整行收起（这里没有"拔掉适配器"这回事，见 SyncAutoRow） -->
              <StackPanel x:Name="AutoHost" Margin="0,10,0,0" Visibility="Collapsed"/>

              <!-- 笔记本屏幕亮度（2026-11-05）：切档会切电源计划，而每条计划各自存着「显示器亮度」
                   索引（本机 平衡 75 / 办公 55 / 游戏 50 / 高性能 40）⇒ 一切档屏幕就跳。
                   这里给一个就地能拨的入口。语义 = **每档各自记住**：写亮度会同时更新
                   当前那条计划的索引，所以这档调到多少、切走再切回来还是多少。
                   ⚠️ 只对**内建屏**有效：外接显示器走 DDC/CI，这套 WMI 管不到。
                   ⚠️ 读不到内建屏（外接屏 / 台式机）时整块隐藏，不留拖了没反应的滑块；
                      合盖时置灰并在数值位置写"已合盖"（见 SyncBrightEnabled）。 -->
              <StackPanel x:Name="BrightBlock" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid>
                  <TextBlock Text="笔记本屏幕亮度" Style="{StaticResource RowLabel}"/>
                  <TextBlock x:Name="BrightValue" Text="读取中…" HorizontalAlignment="Right"
                             FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                             Typography.NumeralAlignment="Tabular"
                             Foreground="{DynamicResource TxtBrush}"/>
                </Grid>
                <Slider x:Name="BrightSlider" Style="{StaticResource RangeSlider}"
                        Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                        Margin="0,6,0,0"
                        ToolTip="笔记本内建屏的亮度（0~100）。亮度记在当前电源计划上 —— 切模式会回到目标计划自己的值。外接显示器不走这套接口，这里调不到它；合盖时内建屏断电，调了也看不见"/>
              </StackPanel>
            </StackPanel>

            <!-- ② 显卡模式（没有 gfx_switch 能力的机型整块拿掉，见 ApplyCaps） -->
            <StackPanel x:Name="GfxBlock" Grid.Row="2">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="显卡模式" Style="{StaticResource RowLabel}"/>
                <TextBlock x:Name="GfxNow" Text="当前：读取中…" Style="{StaticResource RowLabel}"
                           FontWeight="SemiBold" Margin="6,0,0,0"/>
              </StackPanel>
              <Grid x:Name="GfxHost" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
              </Grid>

              <!-- 计划中的重启：只有快照里存在**延迟重启**（外部客户端排的）时才露出来 ——
                   本界面自己只发 `/t 0`，走不到这里。默认 Collapsed。 -->
              <Border x:Name="RebootRow" Style="{StaticResource KvRow}"
                      Margin="0,8,0,0" Visibility="Collapsed">
                <DockPanel>
                  <Button x:Name="RebootCancel" DockPanel.Dock="Right" Content="取消重启"
                          Style="{StaticResource LinkButton}" Padding="10,3" FontSize="11.5"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          ToolTip="取消已计划的重启（shutdown /a）。取消后显卡模式的值仍留在 EC 里，等你自己重启时才会生效"/>
                  <TextBlock x:Name="RebootText" Style="{StaticResource KvLabel}"
                             Foreground="{DynamicResource TxtBrush}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
            </StackPanel>

            <!-- ③ 电源计划（原来「电源与电池」卡并进来的，与切模式联动的那一份） -->
            <StackPanel Grid.Row="4">
              <TextBlock Text="电源计划" Style="{StaticResource RowLabel}" Margin="0,0,0,6"/>
              <StackPanel x:Name="PlansHost"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <!-- ==================== 显卡超频 ==================== -->
      <Border Grid.Column="1" Style="{StaticResource CardBox}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource CardIcon}" Data="{x:Static ui:Icons.Oc}"/>
              <TextBlock Text="显卡超频" Style="{StaticResource CardTitle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <!-- 型号（NVML 的 nvmlDeviceGetName）：读不到就整块不显示 -->
              <Border x:Name="OcNameBox" Style="{StaticResource CardTag}" Margin="0,0,8,0"
                      Visibility="Collapsed">
                <TextBlock x:Name="OcName" Style="{StaticResource CardTagText}"/>
              </Border>
              <!-- 状态标签：就绪 / 需管理员权限 / 核显模式 / 读不到 NVML / 不可用。
                   不可用时这行文字是**唯一**能问出原因的地方（按钮与滑块都已置灰），
                   所以 tooltip 必须挂在这个 Border 上（挂在里面那个 TextBlock 上，
                   鼠标停在 padding 上就什么都没有）。 -->
              <Border x:Name="OcStateBox" Style="{StaticResource CardTag}">
                <TextBlock x:Name="OcState" Text="读取中…" Style="{StaticResource CardTagText}"/>
              </Border>
            </StackPanel>
          </Grid>

          <!-- 免责声明钉在卡底（等价 flex:0 0 auto）。
               ⚠️ 卡里**只保留这一句**：驱动允许范围 / 重启后归零 / 上限含义等说明
                  都已按用户要求删光，别再往这张卡里加别的 hint。 -->
          <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,12,0,0"
                     LineHeight="18"
                     Text="超频有风险：偏移超出硬件稳定范围可能造成花屏、驱动重置或系统死机，长期高温也会缩短硬件寿命。滑块上限是驱动允许值，不代表本机能长期稳定运行 —— 请小步试探，异常立即复位（0）。由此产生的风险由使用者自行承担。"/>

          <!-- 滑块与按钮也钉在底部，剩下的高度留给实时值 -->
          <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
              <TextBlock Text="核心超频" Style="{StaticResource RowLabel}"/>
              <TextBlock x:Name="OcCoreValue" Text="0" Style="{StaticResource KvValue}" Margin="6,0,0,0"/>
              <TextBlock Text=" MHz" Style="{StaticResource RowLabel}"/>
            </StackPanel>
            <Slider x:Name="OcCoreSlider" Style="{StaticResource RangeSlider}"
                    Minimum="-1000" Maximum="1000" SmallChange="5" LargeChange="50"
                    TickFrequency="5" IsSnapToTickEnabled="True"/>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,7">
              <TextBlock Text="显存超频" Style="{StaticResource RowLabel}"/>
              <TextBlock x:Name="OcMemValue" Text="0" Style="{StaticResource KvValue}" Margin="6,0,0,0"/>
              <TextBlock Text=" MHz" Style="{StaticResource RowLabel}"/>
            </StackPanel>
            <Slider x:Name="OcMemSlider" Style="{StaticResource RangeSlider}"
                    Minimum="-1000" Maximum="3000" SmallChange="10" LargeChange="100"
                    TickFrequency="10" IsSnapToTickEnabled="True"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
              <Button x:Name="OcApplyButton" Content="应用超频" Style="{StaticResource MiniButton}"
                      Margin="0,0,8,0" Click="OcApply_Click"/>
              <Button x:Name="OcResetButton" Content="复位 (0)" Style="{StaticResource MiniButtonDanger}"
                      Margin="0,0,12,0" Click="OcReset_Click"/>
              <TextBlock x:Name="OcNow" Text="读取中…" Style="{StaticResource RowLabel}"/>
            </StackPanel>
          </StackPanel>

          <!-- 实时值：频率 / 显存频率 / 电源状态 / 温度 / 功耗 / 显卡电压
               ⚠️ 缺项整行隐藏、全缺整块收起（项目铁律：不留占位横线、不补 0）
               ⚠️ VerticalAlignment=Center：行少时在余量里居中（等价 align-content:space-evenly） -->
          <StackPanel x:Name="OcLive" VerticalAlignment="Stretch" Visibility="Collapsed"/>
        </DockPanel>
      </Border>
    </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
