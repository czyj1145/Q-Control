<UserControl x:Class="QControl.App.Ui.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:QControl.App.Ui"
             xmlns:ctrl="clr-namespace:QControl.App.Ui.Controls"
             Background="Transparent">

  <!--
    硬件页 —— **整页一张卡**的扁平规格表：
      卡头：标题 + 「只读」tag + 三颗按钮（显示进阶信息 / 重新采集 / 复制全部）
      系统横幅：左边系统全名 + 版本号/计算机名等行，右边「本机档案」统计盒
      规格表：8 组各一行 —— 左「彩色徽标 + 组名」，右「主型号 + 指标流」

    ⚠️ 这一页**只读**：不写 EC、不改任何配置。三颗按钮全是本地动作
       （展开折叠 / 后台重采 / 复制到剪贴板）。
    ⚠️ 分组显示顺序走 HW_ORDER（与后端采集顺序是两回事），徽标配色走 HW_COLOR；
       浅色主题下徽标要换成「淡彩底 + 深彩图标」（白图标在亮色块上只有 ~2:1）。
    ⚠️ 进阶行（序列号/设备 ID/缓存/EC 寄存器）默认折叠，展开态走 `presets.ui.hw_adv_open`。
  -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QControl;component/Ui/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- ⚠️ Style=PageScroll：滚动条**浮**在最外侧 8px 上，出现时不挤动卡片（见 Theme.xaml 同名样式） -->
  <ScrollViewer x:Name="Scroll" Style="{StaticResource PageScroll}"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                VerticalContentAlignment="Stretch" Focusable="False" Padding="0">
    <Grid x:Name="Root" MinHeight="{Binding ViewportHeight, ElementName=Scroll}"
          VerticalAlignment="Stretch">
      <Border Margin="19,15,19,15" Style="{StaticResource CardBox}">
        <DockPanel>

          <!-- ==================== 卡头 ==================== -->
          <!-- ⚠️ 卡头是**单格 Grid**：贴着 Left / Right 放两个 StackPanel。
               以前「只读」tag 和按钮各自 HorizontalAlignment=Right 扔在同一格里，
               两者**叠在一起**画（tag 的半透明胶囊压在图标上，看着像图标画坏了）。
               卡头是一条横向流水线，这里排成
               「tag + 三颗按钮」同一个右对齐 StackPanel，间距 8（与 .hw-top 实测一致）。 -->
          <Grid DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
              <Path Style="{StaticResource CardIcon}" Data="{x:Static ui:Icons.Hardware}"/>
              <TextBlock Text="硬件档案" Style="{StaticResource CardTitle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Border Style="{StaticResource CardTag}" Margin="0,0,8,0"
                      ToolTip="只读 · 采集自 WMI / NVML，不写 EC、不改任何配置">
                <TextBlock Text="只读 · WMI / NVML" Style="{StaticResource CardTagText}"/>
              </Border>
              <!-- 三颗按钮：图标 + 文字横排（.mini 里的 svg + span）。
                   ⚠️ Padding/Margin 全部显式写成与 MiniButton 一致的值：MiniCard 是给
                   「温度来源」那种小胶囊用的（10,5 + 右 6），直接拿来当卡头按钮会比旁边
                   两颗矮 2px、窄 2px，一排里高矮不齐。 -->
              <ctrl:CardButton x:Name="AdvButton" Style="{StaticResource MiniCard}"
                               Margin="0,0,8,0" Padding="12,6"
                               Click="Adv_Click" ToolTip="显示序列号 / 设备 ID / 缓存 / EC 寄存器这类进阶信息"/>
              <Button x:Name="RefreshButton" Style="{StaticResource MiniButton}" Margin="0,0,8,0"
                      Click="Refresh_Click" ToolTip="重新跑一遍 WMI 查询（只读，不碰 EC）"/>
              <Button x:Name="CopyButton" Style="{StaticResource MiniButton}"
                      Click="Copy_Click" ToolTip="把这一页的全部内容复制成纯文本（含进阶信息，发反馈/存档用）"/>
            </StackPanel>
          </Grid>

          <!-- ==================== 系统横幅 ==================== -->
          <Grid DockPanel.Dock="Top" Margin="0,2,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="10,0,22,4">
              <TextBlock x:Name="OsTitle" Text="读取中…" Style="{StaticResource HwOsTitle}"/>
              <!-- 版本号/计算机名/系统架构/安装日期（从「主板」组提上来的行） -->
              <WrapPanel x:Name="OsRows" Orientation="Horizontal" Margin="0,8,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource HwStatBox}">
              <StackPanel>
                <TextBlock Text="本机档案" Style="{StaticResource HwStatLabel}"/>
                <TextBlock x:Name="StatValue" Text="--" Style="{StaticResource HwStatValue}"/>
                <TextBlock x:Name="StatSub" Text="" Style="{StaticResource HwStatSub}"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ==================== 规格表（8 组） ==================== -->
          <StackPanel x:Name="GroupsHost" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
